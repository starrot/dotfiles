confirm() {
    [ "$(printf "No\nYes" | dmenu -p "Are you sure?")" = "Yes" ]
}

case "$(printf "Shutdown\nReboot\nLock\nLogout" | dmenu -p "Power")" in
    Shutdown)
        confirm && systemctl poweroff
        ;;
    Reboot)
        confirm && systemctl reboot
        ;;
    Lock)
        slock
        ;;
    Logout)
        confirm && bspc quit
        ;;
esac
